---
import Layout from "../../layouts/Layout.astro";
import FeaturedCarousel from "../../components/FeaturedCarousel.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n/translations";

const locale = "es";
const base = import.meta.env.BASE_URL;

// Get featured projects
const allProjects = await getCollection("projects", ({ id }) => {
  return id.startsWith("es/");
});

const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const title =
  "Ingeniero Civil - Infraestructura Pesada | 40+ Años de Experiencia";
const description =
  "Especialista en proyectos hidráulicos y ferroviarios con más de 40 años de experiencia. Participación en obras emblemáticas como Presa Huites, Tren Maya y proyectos internacionales.";
---

<Layout title={title} description={description} locale={locale}>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-blueprint-blue mb-6"
        >
          {t(locale, "hero.title")}
        </h1>
        <div class="dimension-line max-w-xs mx-auto mb-6"></div>
        <p class="text-xl md:text-2xl text-gray-700 max-w-3xl mx-auto mb-8">
          40+ años de excelencia en proyectos hidráulicos y ferroviarios
        </p>
        <a
          href={`${base}${locale}/proyectos`}
          class="inline-block px-8 py-3 bg-white hover:bg-gray-100 text-blueprint-blue border-2 border-blueprint-blue font-semibold rounded-md transition-colors shadow-lg hover:shadow-xl"
        >
          {t(locale, "hero.cta")}
        </a>
      </div>

      <!-- Key Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16">
        <div class="technical-border bg-white p-6 rounded-lg text-center">
          <div class="font-mono text-4xl font-bold text-blueprint-blue mb-2">
            40+
          </div>
          <div class="text-gray-600 font-medium">Años de Experiencia</div>
        </div>
        <div class="technical-border bg-white p-6 rounded-lg text-center">
          <div class="font-mono text-4xl font-bold text-blueprint-blue mb-2">
            3M+
          </div>
          <div class="text-gray-600 font-medium">m³ de Concreto</div>
          <div class="text-sm text-gray-500 mt-1">(Presa Huites)</div>
        </div>
        <div class="technical-border bg-white p-6 rounded-lg text-center">
          <div class="font-mono text-4xl font-bold text-blueprint-blue mb-2">
            105
          </div>
          <div class="text-gray-600 font-medium">km Pavimento</div>
          <div class="text-sm text-gray-500 mt-1">(Proyectos Nicaragua)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Carousel -->
  <FeaturedCarousel locale={locale} />

  <!-- Expertise Areas -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-blueprint-blue mb-4"
        >
          Áreas de Especialización
        </h2>
        <div class="dimension-line max-w-xs mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="technical-border bg-white p-8 rounded-lg">
          <div class="text-4xl mb-4">🚂</div>
          <h3 class="text-2xl font-heading font-bold text-blueprint-blue mb-3">
            Infraestructura Ferroviaria
          </h3>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Rehabilitación y modernización de vías férreas</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Corrección de curvatura y alineamiento</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Conexiones portuarias y logística</span>
            </li>
          </ul>
        </div>

        <div class="technical-border bg-white p-8 rounded-lg">
          <div class="text-4xl mb-4">🌊</div>
          <h3 class="text-2xl font-heading font-bold text-blueprint-blue mb-3">
            Proyectos Hidráulicos
          </h3>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Construcción de presas y cortinas</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Concreto masivo post-enfriado</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Obras de control hidráulico</span>
            </li>
          </ul>
        </div>

        <div class="technical-border bg-white p-8 rounded-lg">
          <div class="text-4xl mb-4">🛣️</div>
          <h3 class="text-2xl font-heading font-bold text-blueprint-blue mb-3">
            Pavimentos de Concreto
          </h3>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Carreteras y vías de alto tráfico</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Pavimentos rígidos y flexibles</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Proyectos internacionales</span>
            </li>
          </ul>
        </div>

        <div class="technical-border bg-white p-8 rounded-lg">
          <div class="text-4xl mb-4">📋</div>
          <h3 class="text-2xl font-heading font-bold text-blueprint-blue mb-3">
            Servicios Técnicos
          </h3>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Supervisión de obra</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Asesoría contractual y técnica</span>
            </li>
            <li class="flex items-start">
              <span class="text-safety-orange mr-2">•</span>
              <span>Dirección de proyectos</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
