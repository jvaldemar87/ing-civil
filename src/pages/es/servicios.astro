---
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/translations";

const locale = "es";
const title = t(locale, "nav.services");
const description =
    "Catálogo de servicios profesionales de ingeniería civil e infraestructura.";

const services = [
    {
        title: "Estudios y Proyectos",
        desc: "Desarrollo integral de ingeniería básica y de detalle, estudios de factibilidad técnica y económica, y diseño estructural para garantizar la viabilidad y seguridad de cada obra.",
        icon: "📐",
    },
    {
        title: "Presupuestos y Concursos",
        desc: "Análisis detallado de costos unitarios, elaboración de catálogos de conceptos y preparación de documentación técnica para licitaciones públicas y privadas.",
        icon: "📊",
    },
    {
        title: "Control Técnico y Contratos",
        desc: "Supervisión rigurosa de la ejecución, control de calidad, seguimiento de avances físico-financieros y gestión administrativa de contratos para asegurar el cumplimiento de tiempos y costos.",
        icon: "📋",
    },
    {
        title: "Recuperación de Sobrecostos",
        desc: "Análisis y gestión de reclamos por escalatorias, trabajos extraordinarios y gastos no recuperables, protegiendo la rentabilidad financiera del proyecto.",
        icon: "💰",
    },
    {
        title: "Auditorías Técnicas",
        desc: "Evaluaciones preventivas y correctivas para verificar el cumplimiento normativo, técnico y financiero, identificando riesgos y áreas de oportunidad en sus proyectos.",
        icon: "🔍",
    },
    {
        title: "Construcción y Mantenimiento",
        desc: "Ejecución de obra civil, edificación y mantenimiento preventivo/correctivo, asegurando la operatividad y vida útil de la infraestructura.",
        icon: "🏗️",
    },
];
---

<Layout title={title} description={description} locale={locale}>
    <!-- Hero Section -->
    <section
        class="relative py-20 bg-background text-blueprint-blue overflow-hidden border-b border-blueprint-blue/20"
    >
        <div
            class="absolute inset-0 opacity-20 bg-[radial-gradient(#0047AB_1px,transparent_1px)] [background-size:20px_20px]"
        >
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 text-blueprint-blue"
            >
                {title}
            </h1>
            <div class="h-1 w-20 bg-safety-orange mb-6"></div>
            <p class="text-xl max-w-2xl text-gray-700">
                Soluciones integrales con rigor técnico y experiencia
                comprobada.
            </p>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <div class="technical-border bg-white p-8 rounded-lg hover:shadow-lg transition-all duration-300 group">
                            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 transform origin-left">
                                {service.icon}
                            </div>
                            <h3 class="text-xl font-heading font-bold text-blueprint-blue mb-4 border-b border-blueprint-blue/10 pb-2">
                                {service.title}
                            </h3>
                            <p class="text-gray-600 leading-relaxed">
                                {service.desc}
                            </p>
                        </div>
                    ))
                }
            </div>

            <!-- CTA Section -->
            <div class="mt-16 text-center">
                <a
                    href={`/${locale}/contacto`}
                    class="inline-flex items-center justify-center px-8 py-3 bg-blueprint-blue text-white font-bold rounded-lg hover:bg-blueprint-blue-dark transition-colors shadow-md"
                >
                    Solicitar Información
                    <svg
                        class="w-5 h-5 ml-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</Layout>
